# SwiftPM build products. .build alone is several gigabytes of compiled
# dependencies and checkouts — never commit it.
.worktrees/
.build/
.swiftpm/
*.o
*.dSYM/

# graphify's code-graph output: a multi-megabyte cache of derived JSON keyed by
# content hash, regenerated by the tool. scripts/release.sh refuses to run with
# a dirty tree, and an untracked generated directory was enough to block it.
graphify-out/

# The assembled .app produced by build-app.sh, plus the notarisation archive.
build/
*.zip
*.dmg

# Package.resolved IS committed on purpose: one dependency (speech-swift) tracks
# branch "main", so the resolved file is the only thing pinning it to a revision
# that builds. Do not add it here.

# macOS
.DS_Store

# Xcode, if anyone opens the package in it
*.xcuserdatad/
xcuserdata/
DerivedData/

# Sparkle update-signing private key. The public half lives in Info.plist;
# leaking this file would let anyone sign updates as us.
scripts/sparkle_ed25519_private.pem
