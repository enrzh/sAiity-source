<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key><string>en</string>
  <key>CFBundleLocalizations</key><array><string>en</string><string>de</string><string>fr</string><string>es</string><string>ja</string></array>
  <key>CFBundleName</key><string>sAiity</string>
  <key>CFBundleDisplayName</key><string>sAiity</string>
  <!-- Lowercase: reverse-DNS ids are case-folded inconsistently by LaunchServices
       and tooling, so the brand's capital A stays out of the identifier. -->
  <key>CFBundleIdentifier</key><string>de.aiity.saiity</string>
  <key>CFBundleExecutable</key><string>sAiity</string>
  <key>CFBundleIconFile</key><string>AppIcon</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>0.1.0</string>
  <key>CFBundleVersion</key><string>1</string>
  <key>LSMinimumSystemVersion</key><string>26.0</string>
  <!-- Menu-bar only: no Dock icon, no Cmd-Tab entry. Still visible in Finder,
       Spotlight and Launchpad once installed to /Applications. -->
  <key>LSUIElement</key><true/>
  <!-- Sparkle. Automatic checks are OFF until the user opts in during
       onboarding — an app that phones home for updates without asking would
       undercut its own privacy pitch, even though update checks carry no
       user data. -->
  <key>SUFeedURL</key><string>https://enrzh.github.io/sAiity/appcast.xml</string>
  <key>SUPublicEDKey</key><string>DzbCne8eregDpstl+s0s7lID5lVvzbB8OrXorH7ccMQ=</string>
  <key>SUEnableAutomaticChecks</key><false/>
  <!-- saiity://toggle|start|stop|copy|bubble — the automation surface for
       Shortcuts, Raycast and scripts. App Intents cannot work here: the
       bundle is assembled from `swift build`, so Xcode's intents metadata
       step never runs and Shortcuts would not discover them. -->
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key><string>de.aiity.saiity.automation</string>
      <key>CFBundleURLSchemes</key><array><string>saiity</string></array>
    </dict>
  </array>
  <key>NSHumanReadableCopyright</key><string>On-device live subtitles. See Credits in the app's About window.</string>
  <key>LSApplicationCategoryType</key><string>public.app-category.utilities</string>
  <!-- ScreenCaptureKit system-audio capture triggers the Screen Recording
       prompt, which macOS does not gate on an Info.plist string.

       The microphone entry backs exactly ONE opt-in setting ("Include my
       microphone", off by default): system audio on a call carries only the
       remote side, so without it a transcript misses the user's own half.
       The prompt is only ever triggered after the user turns that setting
       on. There is deliberately NO camera entry — the app has no camera call
       site, and declaring intent it does not have is both untrue and an
       automatic App Store 5.1.1 rejection. -->
  <key>NSMicrophoneUsageDescription</key><string>Only used if you turn on “Include my microphone”: your side of a call is mixed into the captions and transcript. Audio never leaves this Mac.</string>
  <key>NSSpeechRecognitionUsageDescription</key><string>Speech is transcribed entirely on this Mac. Nothing is uploaded.</string>
</dict>
</plist>
