    "Stop the captions first — the translator is busy with the live session.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppe zuerst die Untertitel – der Übersetzer ist mit der laufenden Sitzung beschäftigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detén primero los subtítulos: el traductor está ocupado con la sesión en curso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrête d’abord les sous-titres : le traducteur est occupé par la session en cours."
