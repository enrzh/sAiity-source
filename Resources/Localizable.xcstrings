    "That means a one-time model download — you choose which.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dafür wird einmalig ein Modell geladen – du wählst welches."
          }
        }
      }
    },
    "This only picks a starting model. You can change it any time in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
