    "Width": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Breite"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancho"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Largeur"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "幅"
          }
        }
      }
    },
    "Width is a setting rather than something measured from the text — that is what stops the bubble resizing and re-centring on every line. Drag an edge to override it; a dragged width may go right to the screen edge.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Breite ist eine Einstellung und wird nicht aus dem Text gemessen – genau das verhindert, dass die Sprechblase bei jeder Zeile ihre Größe ändert und sich neu zentriert. Zieh eine Kante, um sie zu überschreiben; eine gezogene Breite darf bis an den Bildschirmrand reichen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ancho es un ajuste, no algo medido a partir del texto — eso es lo que evita que la burbuja cambie de tamaño y se vuelva a centrar con cada línea. Arrastra un borde para anularlo; un ancho arrastrado puede llegar hasta el borde de la pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La largeur est un réglage plutôt qu'une mesure tirée du texte — c'est ce qui empêche la bulle de se redimensionner et de se recentrer à chaque ligne. Faites glisser un bord pour la modifier ; une largeur ajustée peut aller jusqu'au bord de l'écran."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "幅はテキストから測った値ではなく設定値です — だからこそ、行が変わるたびにバブルがサイズ変更されて中央に置き直されることがありません。端をドラッグすると上書きでき、ドラッグした幅は画面の端まで広げられます。"
          }
        }
      }
    },
    "Window": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenster"
