    "Specialist and local LLM models are optional. Use them when you have a tested reason to prefer them.": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Spezialisten- und lokale LLM-Modelle sind optional. Verwende sie nur, wenn du einen geprüften Grund dafür hast." } },
        "es": { "stringUnit": { "state": "translated", "value": "Los modelos especializados y LLM locales son opcionales. Úsalos cuando tengas un motivo comprobado para preferirlos." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Les modèles spécialisés et les LLM locaux sont facultatifs. Utilisez-les lorsque vous avez une raison testée de les préférer." } },
        "ja": { "stringUnit": { "state": "translated", "value": "専門モデルとローカルLLMはオプションです。使う理由を確認できた場合に選択してください。" } }
