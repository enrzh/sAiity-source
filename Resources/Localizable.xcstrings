    "Accessibility access is enabled": { "extractionState": "manual", "localizations": { "de": { "stringUnit": { "state": "translated", "value": "Bedienungshilfen aktiviert" } }, "es": { "stringUnit": { "state": "translated", "value": "Acceso a Accesibilidad activado" } }, "fr": { "stringUnit": { "state": "translated", "value": "Accès à l’accessibilité activé" } }, "ja": { "stringUnit": { "state": "translated", "value": "アクセシビリティアクセスが有効です" } } } },
    "Accessibility": { "extractionState": "manual", "localizations": { "de": { "stringUnit": { "state": "translated", "value": "Bedienungshilfen" } }, "es": { "stringUnit": { "state": "translated", "value": "Accesibilidad" } }, "fr": { "stringUnit": { "state": "translated", "value": "Accessibilité" } }, "ja": { "stringUnit": { "state": "translated", "value": "アクセシビリティ" } } } },
    "After granting access, quit and reopen sAiity.": { "extractionState": "manual", "localizations": { "de": { "stringUnit": { "state": "translated", "value": "Beende sAiity nach dem Erteilen des Zugriffs und öffne die App erneut." } }, "es": { "stringUnit": { "state": "translated", "value": "Después de conceder el acceso, cierra sAiity y vuelve a abrirlo." } }, "fr": { "stringUnit": { "state": "translated", "value": "Après avoir accordé l’accès, quittez puis rouvrez sAiity." } }, "ja": { "stringUnit": { "state": "translated", "value": "アクセスを許可した後、sAiityを終了して再度開いてください。" } } } },
    "Allow…": { "extractionState": "manual", "localizations": { "de": { "stringUnit": { "state": "translated", "value": "Erlauben …" } }, "es": { "stringUnit": { "state": "translated", "value": "Permitir…" } }, "fr": { "stringUnit": { "state": "translated", "value": "Autoriser…" } }, "ja": { "stringUnit": { "state": "translated", "value": "許可…" } } } },
    "Allowed": { "extractionState": "manual", "localizations": { "de": { "stringUnit": { "state": "translated", "value": "Erlaubt" } }, "es": { "stringUnit": { "state": "translated", "value": "Permitido" } }, "fr": { "stringUnit": { "state": "translated", "value": "Autorisé" } }, "ja": { "stringUnit": { "state": "translated", "value": "許可済み" } } } },
    "Dictation is separate from live captions. It never starts the caption service and is not saved as a meeting transcript.": { "extractionState": "manual", "localizations": { "de": { "stringUnit": { "state": "translated", "value": "Das Diktat ist von den Live-Untertiteln getrennt. Es startet den Untertiteldienst nicht und wird nicht als Gesprächstranskript gespeichert." } }, "es": { "stringUnit": { "state": "translated", "value": "El dictado es independiente de los subtítulos en directo. No inicia el servicio de subtítulos ni se guarda como transcripción de una reunión." } }, "fr": { "stringUnit": { "state": "translated", "value": "La dictée est séparée des sous-titres en direct. Elle ne démarre pas le service de sous-titres et n’est pas enregistrée comme transcription de réunion." } }, "ja": { "stringUnit": { "state": "translated", "value": "音声入力はライブ字幕とは別の機能です。字幕サービスを開始せず、会議の文字起こしとして保存されません。" } } } },
    "Dictating, transcribing, and the clipboard result appear briefly above the bottom edge of the screen.": { "extractionState": "manual", "localizations": { "de": { "stringUnit": { "state": "translated", "value": "Diktat, Transkription und das Ergebnis in der Zwischenablage erscheinen kurz über dem unteren Bildschirmrand." } }, "es": { "stringUnit": { "state": "translated", "value": "El dictado, la transcripción y el resultado del portapapeles aparecen brevemente sobre el borde inferior de la pantalla." } }, "fr": { "stringUnit": { "state": "translated", "value": "La dictée, la transcription et le résultat dans le presse-papiers apparaissent brièvement au-dessus du bord inférieur de l’écran." } }, "ja": { "stringUnit": { "state": "translated", "value": "音声入力、文字起こし、クリップボードの結果は画面下端の上に短時間表示されます。" } } } },
    "Dictation": {
      "extractionState": "manual",
      "localizations": {
