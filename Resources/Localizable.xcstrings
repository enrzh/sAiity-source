    "System-audio capture is gated behind Screen Recording — macOS has no audio-only permission.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufnahme des Systemtons hängt an der Bildschirmaufnahme – macOS kennt keine Berechtigung nur für Ton."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La captura del audio del sistema está detrás de Grabación de pantalla — macOS no tiene un permiso solo de audio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La capture de l'audio système passe par Enregistrement de l'écran — macOS n'a pas d'autorisation audio seule."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムオーディオのキャプチャは画面収録の権限で管理されています — macOSには音声専用の権限がありません。"
          }
        }
      }
    },
    "System-wide. Click a field and press the combination; ⌫ clears. Needs ⌃, ⌥ or ⌘.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemweit. Klicke ein Feld an und drücke die Kombination; ⌫ löscht sie. Benötigt ⌃, ⌥ oder ⌘."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para todo el sistema. Haz clic en un campo y pulsa la combinación; ⌫ borra. Necesita ⌃, ⌥ o ⌘."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À l'échelle du système. Cliquez sur un champ et appuyez sur la combinaison ; ⌫ efface. Nécessite ⌃, ⌥ ou ⌘."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム全体で有効です。フィールドをクリックして組み合わせを押してください。⌫で消去します。⌃、⌥、⌘のいずれかが必要です。"
          }
        }
      }
    },
    "That URL answers with a web page, not a model file. Use the direct download link.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese URL liefert eine Webseite, keine Modelldatei. Verwende den direkten Download-Link."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa URL responde con una página web, no con un archivo de modelo. Usa el enlace de descarga directa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette URL répond par une page web, pas par un fichier de modèle. Utilisez le lien de téléchargement direct."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このURLはモデルファイルではなくWebページを返します。直接ダウンロードリンクを使用してください。"
          }
        }
      }
    },
    "%@ failed its integrity check. Try again.": {
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "%@ hat die Integritätsprüfung nicht bestanden. Versuche es erneut." } },
        "es": { "stringUnit": { "state": "translated", "value": "%@ no superó la comprobación de integridad. Inténtalo de nuevo." } },
        "fr": { "stringUnit": { "state": "translated", "value": "%@ a échoué au contrôle d’intégrité. Réessaie." } },
        "ja": { "stringUnit": { "state": "translated", "value": "%@ は整合性チェックに失敗しました。もう一度お試しください。" } }
      }
    },
    "That URL did not answer with a downloadable file (HTTP %lld).": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese URL hat nicht mit einer ladbaren Datei geantwortet (HTTP %lld)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa URL no respondió con un archivo descargable (HTTP %lld)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette URL n'a pas répondu par un fichier téléchargeable (HTTP %lld)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このURLからはダウンロード可能なファイルが返されませんでした（HTTP %lld）。"
          }
        }
      }
    },
    "That combination is already taken by another app.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Kombination ist bereits von einer anderen App belegt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa combinación ya la usa otra app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette combinaison est déjà prise par une autre app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この組み合わせはすでにほかのアプリで使用されています。"
          }
        }
      }
    },
    "That file is empty or unreadable.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei ist leer oder nicht lesbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese archivo está vacío o no se puede leer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier est vide ou illisible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルは空か、読み取れません。"
          }
        }
      }
    },
    "That file is not a GGUF model file.": {
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Diese Datei ist keine GGUF-Modelldatei." } },
        "es": { "stringUnit": { "state": "translated", "value": "Este archivo no es un modelo GGUF." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Ce fichier n’est pas un modèle GGUF." } },
        "ja": { "stringUnit": { "state": "translated", "value": "このファイルはGGUFモデルではありません。" } }
      }
    },
    "That means a one-time model download — you choose which.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dafür wird einmalig ein Modell geladen – du wählst welches."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eso supone una única descarga de modelo — tú eliges cuál."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela implique un téléchargement de modèle unique — vous choisissez lequel."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "つまり、モデルを一度だけダウンロードする必要があります — どのモデルにするかは選べます。"
          }
        }
      }
    },
    "That transcript has no lines.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Transkript hat keine Zeilen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa transcripción no tiene líneas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette transcription ne contient aucune ligne."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その文字起こしには行がありません。"
          }
        }
      }
    },
    "The default. Captions arrive about every 2 seconds at the lowest recognition cost.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Voreinstellung. Untertitel erscheinen etwa alle 2 Sekunden bei geringstem Erkennungsaufwand."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La opción predeterminada. Los subtítulos llegan más o menos cada 2 segundos con el mínimo trabajo de reconocimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le réglage par défaut. Les sous-titres arrivent environ toutes les 2 secondes, au coût de reconnaissance le plus bas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトです。約2秒ごとに字幕が届き、認識コストは最小です。"
          }
        }
      }
    },
    "The quality pick among the LLM options. About the speed of Qwen 4B; the prompt heuristics here were tuned on Qwen, so behaviour may differ slightly.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Qualitätswahl unter den LLM-Optionen. Etwa so schnell wie Qwen 4B; die Prompt-Heuristiken hier wurden auf Qwen abgestimmt, das Verhalten kann also leicht abweichen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La elección de calidad entre las opciones de LLM. Más o menos la velocidad de Qwen 4B; las heurísticas del prompt se ajustaron con Qwen, así que el comportamiento puede variar un poco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le choix qualité parmi les options LLM. Environ la vitesse de Qwen 4B ; les heuristiques de prompt ont été réglées sur Qwen, le comportement peut donc différer légèrement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LLMの選択肢の中では品質重視の選択です。速度はQwen 4Bと同程度です。プロンプトのヒューリスティクスはQwenに合わせて調整されているため、動作が少し異なることがあります。"
          }
        }
      }
    },
    "The recognised speech. It is dimmed while the engine may still revise it — that is the second opacity below.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die erkannte Sprache. Sie ist abgedunkelt, solange die Engine sie noch überarbeiten kann – das ist die zweite Deckkraft unten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El habla reconocida. Se atenúa mientras el motor aún puede revisarla — esa es la segunda opacidad de abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La parole reconnue. Elle est atténuée tant que le moteur peut encore la réviser — c'est la seconde opacité ci-dessous."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認識された発話です。エンジンがまだ修正する可能性がある間は薄く表示されます — それが下の2つ目の不透明度です。"
          }
        }
      }
    },
    "The same multilingual model decoding every %lld ms instead of %lld — captions appear about twice as fast, for roughly double the encoder work per second of audio. Noticeable on battery. A separate download; both tiers can be installed.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dasselbe mehrsprachige Modell, das alle %lld ms statt alle %lld decodiert – Untertitel erscheinen etwa doppelt so schnell, bei ungefähr doppelter Encoder-Arbeit pro Sekunde Ton. Im Akkubetrieb spürbar. Ein eigener Download; beide Stufen lassen sich installieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mismo modelo multilingüe decodificando cada %lld ms en vez de %lld — los subtítulos aparecen cerca del doble de rápido, a cambio de aproximadamente el doble de trabajo del codificador por segundo de audio. Se nota con batería. Es una descarga aparte; se pueden instalar ambos niveles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le même modèle multilingue décodant toutes les %lld ms au lieu de %lld — les sous-titres apparaissent environ deux fois plus vite, pour à peu près le double de travail d'encodeur par seconde d'audio. Sensible sur batterie. Un téléchargement séparé ; les deux paliers peuvent être installés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ多言語モデルが、%lld msごと（%lld msごとの代わり）にデコードします — 字幕は約2倍の速さで表示され、音声1秒あたりのエンコーダ処理はおよそ2倍になります。バッテリー駆動では差が体感できます。独立したダウンロードで、両方のティアをインストールできます。"
          }
        }
      }
    },
    "The second line under each caption. Turning this off keeps translation running for the transcript but hides it on screen.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die zweite Zeile unter jedem Untertitel. Aus lässt die Übersetzung fürs Transkript weiterlaufen, blendet sie aber auf dem Bildschirm aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La segunda línea bajo cada subtítulo. Desactivarlo mantiene la traducción en marcha para la transcripción, pero la oculta en pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La seconde ligne sous chaque sous-titre. Désactivé, la traduction continue pour la transcription mais reste masquée à l'écran."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各字幕の下の2行目です。オフにしても文字起こし用の翻訳は動き続け、画面上では非表示になります。"
          }
        }
      }
    },
    "The smallest size whose translation quality holds up. A sensible first choice if you want an LLM doing this.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die kleinste Größe, deren Übersetzungsqualität standhält. Eine sinnvolle erste Wahl, wenn ein LLM das übernehmen soll."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tamaño más pequeño cuya calidad de traducción aguanta. Una primera elección sensata si quieres que esto lo haga un LLM."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La plus petite taille dont la qualité de traduction tient. Un premier choix raisonnable si vous voulez un LLM pour cette tâche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "翻訳品質が保たれる最小サイズです。LLMに翻訳させたい場合の妥当な最初の選択です。"
          }
        }
      }
    },
    "The whole system mix — notification sounds and every other app land in the captions too. Scope to one app to caption a meeting or a film without interference.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der gesamte Systemmix – auch Benachrichtigungstöne und jede andere App landen in den Untertiteln. Beschränke die Aufnahme auf eine App, um ein Meeting oder einen Film ohne Störgeräusche zu untertiteln."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda la mezcla del sistema — los sonidos de notificación y todas las demás apps acaban también en los subtítulos. Limita la captura a una app para subtitular una reunión o una película sin interferencias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout le mixage système — les sons de notification et toutes les autres apps atterrissent aussi dans les sous-titres. Limitez à une app pour sous-titrer une réunion ou un film sans interférence."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム全体のミックスです — 通知音やほかのすべてのアプリの音も字幕に入ります。会議や映画を邪魔されずに字幕化するには、1つのアプリに絞ってください。"
          }
        }
      }
    },
    "This audio has not dropped below the threshold yet — sentences will close on the length cap instead. A longer pause length will not help; scoping capture to one app might.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Audio ist bisher nie unter die Schwelle gefallen – Sätze schließen stattdessen über die Längengrenze. Eine längere Pausenlänge hilft nicht; die Aufnahme auf eine App zu beschränken vielleicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este audio aún no ha bajado del umbral — las frases se cerrarán por el límite de longitud. Una pausa más larga no ayudará; limitar la captura a una app quizá sí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet audio n'est pas encore descendu sous le seuil — les phrases se fermeront sur le plafond de longueur à la place. Une pause plus longue n'aidera pas ; limiter la capture à une app peut aider."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この音声はまだしきい値を下回っていません — 文は代わりに長さ上限で区切られます。ポーズを長くしても解決しません。キャプチャを1つのアプリに絞ると改善することがあります。"
          }
        }
      }
    },
    "This frees %@.\n\nAnything you use again will be downloaded once more.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das gibt %@ frei.\n\nWas du wieder nutzt, wird noch einmal geladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto libera %@.\n\nLo que vuelvas a usar se descargará de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela libère %@.\n\nTout ce que vous réutiliserez sera téléchargé une nouvelle fois."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これで%@が解放されます。\n\nもう一度使うものは、あらためてダウンロードされます。"
          }
        }
      }
    },
    "This is a sample subtitle line, to check size and legibility.": {
      "extractionState": "manual",
      "comment": "Crossed on purpose. This is the preview bubble's TRANSLATED row, which must read in the UI language — do not 'correct' it to an English value.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist eine Beispiel-Untertitelzeile, um Größe und Lesbarkeit zu prüfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta es una línea de subtítulo de ejemplo, para comprobar tamaño y legibilidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci est une ligne de sous-titre d'exemple, pour vérifier la taille et la lisibilité."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは、サイズと読みやすさを確認するためのサンプル字幕です。"
          }
        }
      }
    },
    "This only picks a starting model. You can change it any time in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das wählt nur ein Startmodell. Du kannst es jederzeit in den Einstellungen ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto solo elige el modelo inicial. Puedes cambiarlo en cualquier momento en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci ne choisit qu'un modèle de départ. Vous pouvez en changer à tout moment dans les Réglages."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここで選ぶのは最初のモデルだけです。「設定」でいつでも変更できます。"
          }
        }
      }
    },
    "This tier is its own ~640 MB download — each latency has the chunk size baked into its model. Fetch it under Models.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Stufe ist ein eigener Download von ~640 MB – jede Latenz hat die Blockgröße fest im Modell. Lade sie unter Modelle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este nivel es una descarga aparte de ~640 MB — cada latencia lleva el tamaño de fragmento integrado en su modelo. Descárgalo en Modelos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce palier est un téléchargement à part de ~640 MB — chaque latence a la taille de segment intégrée à son modèle. Récupérez-le sous Modèles."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このティアは約640 MBの独立したダウンロードです — 各遅延設定のモデルには、それぞれのチャンクサイズが焼き込まれています。「モデル」から取得してください。"
          }
        }
      }
    },
    "Times count from the session start. Text can be selected and copied.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeiten zählen ab Sitzungsbeginn. Text lässt sich auswählen und kopieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los tiempos cuentan desde el inicio de la sesión. El texto se puede seleccionar y copiar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les temps comptent depuis le début de la session. Le texte peut être sélectionné et copié."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時刻はセッション開始からの経過時間です。テキストは選択してコピーできます。"
          }
        }
      }
    },
    "Transcribed on device by sAiity.": {
      "extractionState": "manual",
      "localizations": {
