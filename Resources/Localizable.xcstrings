          }
        }
      }
    },
    "Writes every saved session into one folder.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreibt jede gesicherte Sitzung in einen Ordner."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe cada sesión guardada en una carpeta."
          }
        },
        "fr": {
