    "Uses the same target language and local translation model as captions.": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Verwendet dieselbe Zielsprache und dasselbe lokale Übersetzungsmodell wie die Untertitel." } },
        "es": { "stringUnit": { "state": "translated", "value": "Usa el mismo idioma de destino y el mismo modelo de traducción local que los subtítulos." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Utilise la même langue cible et le même modèle de traduction local que les sous-titres." } },
        "ja": { "stringUnit": { "state": "translated", "value": "字幕と同じ翻訳先の言語とローカル翻訳モデルを使用します。" } }
      }
    },
    "Choose a translation target under Captions first.": {
      "extractionState": "manual",
      "localizations": {
