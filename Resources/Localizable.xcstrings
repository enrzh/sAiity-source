    "Keep transcripts": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkripte aufbewahren"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservar transcripciones"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserver les transcriptions"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字起こしの保存期間"
          }
        }
      }
    },
    "Keeping transcripts for %lld days means %lld already older than that are deleted immediately, and any future session is deleted once it reaches that age. This cannot be undone.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkripte %lld Tage aufzubewahren bedeutet: %lld bereits ältere werden sofort gelöscht, und jede künftige Sitzung wird gelöscht, sobald sie dieses Alter erreicht. Das lässt sich nicht rückgängig machen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservar las transcripciones %lld días significa que %lld ya más antiguas se eliminan de inmediato, y cualquier sesión futura se elimina al alcanzar esa antigüedad. Esto no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserver les transcriptions %lld jours signifie que %lld déjà plus anciennes sont supprimées immédiatement, et que toute session future sera supprimée une fois cet âge atteint. Cette action est irréversible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字起こしを%lld日間保存するということは、すでにそれより古い%lld件が直ちに削除され、今後のセッションもその期間に達した時点で削除されるということです。取り消せません。"
          }
        }
      }
    },
