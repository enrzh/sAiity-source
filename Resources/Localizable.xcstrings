    },
    "It captures the audio your Mac plays — the microphone stays off unless you later opt in under Settings → Captions.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es nimmt den Ton auf, den dein Mac abspielt – das Mikrofon bleibt aus, solange du es nicht später unter Einstellungen → Untertitel einschaltest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Captura el audio que tu Mac reproduce — el micrófono queda apagado a menos que luego lo actives en Ajustes → Subtítulos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app capture l'audio que votre Mac lit — le microphone reste coupé, sauf si vous l'activez plus tard dans Réglages → Sous-titres."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macが再生する音声をキャプチャします — マイクは、後で「設定」→「字幕」でオンにしない限りオフのままです。"
          }
        }
      }
    },
    "Keep everything": {
      "extractionState": "manual",
      "localizations": {
