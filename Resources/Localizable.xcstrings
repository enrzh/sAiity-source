    "Optional specialist for 37 languages. Keep it in Advanced until a language-pair benchmark shows it beats MADLAD for your use case.": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Optionales Spezialmodell für 37 Sprachen. Lass es unter Erweitert, bis ein Sprachpaar-Benchmark zeigt, dass es für deinen Anwendungsfall besser als MADLAD ist." } },
        "es": { "stringUnit": { "state": "translated", "value": "Especialista opcional para 37 idiomas. Déjalo en Avanzado hasta que una evaluación por pares de idiomas demuestre que supera a MADLAD en tu caso." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Spécialiste optionnel pour 37 langues. Gardez-le dans Avancé jusqu'à ce qu'un benchmark par paire de langues montre qu'il dépasse MADLAD pour votre usage." } },
        "ja": { "stringUnit": { "state": "translated", "value": "37言語に対応するオプションの専門モデルです。言語ペアのベンチマークで用途におけるMADLAD超えが確認されるまで、詳細設定に置いてください。" } }
      }
    },
    "Experimental local LLM translation. Useful for cleanup and language experiments, but less predictable than a dedicated translation model. Choose a Qwen, Gemma, or custom GGUF under Advanced.": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Experimentelle Übersetzung mit einem lokalen LLM. Nützlich für Bereinigung und Sprachtests, aber weniger vorhersehbar als ein dediziertes Übersetzungsmodell. Wähle unter Erweitert ein Qwen-, Gemma- oder eigenes GGUF-Modell." } },
        "es": { "stringUnit": { "state": "translated", "value": "Traducción experimental con un LLM local. Es útil para limpieza y experimentos de idiomas, pero es menos predecible que un modelo de traducción dedicado. Elige un Qwen, Gemma o GGUF propio en Avanzado." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Traduction expérimentale avec un LLM local. Utile pour le nettoyage et les expériences linguistiques, mais moins prévisible qu'un modèle de traduction dédié. Choisissez un Qwen, Gemma ou GGUF personnalisé dans Avancé." } },
        "ja": { "stringUnit": { "state": "translated", "value": "ローカルLLMによる実験的な翻訳です。クリーンアップや言語実験には便利ですが、専用翻訳モデルより予測しにくい動作になります。詳細設定でQwen、Gemma、またはカスタムGGUFを選択してください。" } }
      }
    },
    "Experimental quality — verify important translations.": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Experimentelle Qualität – wichtige Übersetzungen prüfen." } },
