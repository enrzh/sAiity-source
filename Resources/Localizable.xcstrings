      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Übersetzung nicht verfügbar — Original eingefügt und kopiert" } },
        "es": { "stringUnit": { "state": "translated", "value": "Traducción no disponible: original insertado y copiado" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Traduction indisponible : original inséré et copié" } },
        "ja": { "stringUnit": { "state": "translated", "value": "翻訳を利用できません — 原文を挿入してコピーしました" } }
      }
    },
    "Translation unavailable — original copied to Clipboard": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Übersetzung nicht verfügbar — Original in die Zwischenablage kopiert" } },
        "es": { "stringUnit": { "state": "translated", "value": "Traducción no disponible: original copiado al portapapeles" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Traduction indisponible : original copié dans le presse-papiers" } },
        "ja": { "stringUnit": { "state": "translated", "value": "翻訳を利用できません — 原文をクリップボードにコピーしました" } }
      }
    },
    "Hold your shortcut while speaking. Release it to transcribe on this Mac, then paste into the focused text field or copy the result to the clipboard.": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Halte dein Kürzel beim Sprechen gedrückt. Lass es los, um auf diesem Mac zu transkribieren und das Ergebnis in das fokussierte Textfeld einzufügen oder in die Zwischenablage zu kopieren." } },
        "es": { "stringUnit": { "state": "translated", "value": "Mantén pulsado el atajo mientras hablas. Suéltalo para transcribir en este Mac y pegar el resultado en el campo de texto activo o copiarlo al portapapeles." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Maintenez le raccourci enfoncé pendant que vous parlez. Relâchez-le pour transcrire sur ce Mac, puis insérer le résultat dans le champ de texte actif ou le copier dans le presse-papiers." } },
        "ja": { "stringUnit": { "state": "translated", "value": "話している間ショートカットを押し続けます。離すとこのMacで文字起こしを行い、フォーカス中のテキストフィールドに挿入するか、結果をクリップボードにコピーします。" } }
      }
    },
    "Required to paste dictation into the focused text field.": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Erforderlich, um das Diktat in das fokussierte Textfeld einzufügen." } },
        "es": { "stringUnit": { "state": "translated", "value": "Necesario para pegar el dictado en el campo de texto activo." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Requis pour insérer la dictée dans le champ de texte actif." } },
        "ja": { "stringUnit": { "state": "translated", "value": "フォーカス中のテキストフィールドに音声入力を挿入するために必要です。" } }
      }
    },
    "A short overlay shows dictating, transcribing, and the output above the bottom edge of the screen.": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Eine kurze Einblendung zeigt Diktat, Transkription und das Ergebnis über dem unteren Bildschirmrand." } },
        "es": { "stringUnit": { "state": "translated", "value": "Una breve superposición muestra el dictado, la transcripción y el resultado sobre el borde inferior de la pantalla." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Une courte incrustation affiche la dictée, la transcription et le résultat au-dessus du bord inférieur de l’écran." } },
        "ja": { "stringUnit": { "state": "translated", "value": "短いオーバーレイで、音声入力、文字起こし、結果を画面下端の上に表示します。" } }
      }
    },
    "No speech detected": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Keine Sprache erkannt" } },
        "es": { "stringUnit": { "state": "translated", "value": "No se ha detectado voz" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Aucune voix détectée" } },
        "ja": { "stringUnit": { "state": "translated", "value": "音声が検出されませんでした" } }
      }
    },
    "No model chosen — %@ is the one to start with": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Modell gewählt – %@ ist der Einstieg"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún modelo elegido — %@ es el indicado para empezar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun modèle choisi — %@ est le bon point de départ"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルが未選択です — まずは%@がおすすめです"
          }
        }
      }
    },
    "No recognition model chosen yet. %@ is the one to start with: it handles any language and identifies it from the audio. Download it under Models.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch kein Erkennungsmodell gewählt. %@ ist der Einstieg: Es kommt mit jeder Sprache zurecht und erkennt sie aus dem Ton. Lade es unter Modelle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no has elegido un modelo de reconocimiento. %@ es el indicado para empezar: maneja cualquier idioma y lo identifica a partir del audio. Descárgalo en Modelos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun modèle de reconnaissance choisi pour l'instant. %@ est le bon point de départ : il gère n'importe quelle langue et l'identifie à partir de l'audio. Téléchargez-le sous Modèles."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認識モデルがまだ選択されていません。まずは%@がおすすめです。あらゆる言語に対応し、音声から言語を自動判別します。「モデル」からダウンロードしてください。"
          }
        }
      }
    },
    "No recognition model chosen — pick one in Settings → Models": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Erkennungsmodell gewählt – wähle eines unter Einstellungen → Modelle"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún modelo de reconocimiento elegido — elige uno en Ajustes → Modelos"
          }
        },
        "fr": {
          "stringUnit": {
