    "Hold %@ to Dictate": { "extractionState": "manual", "localizations": { "de": { "stringUnit": { "state": "translated", "value": "%@ zum Diktieren gedrückt halten" } }, "es": { "stringUnit": { "state": "translated", "value": "Mantén pulsado %@ para dictar" } }, "fr": { "stringUnit": { "state": "translated", "value": "Maintenez %@ pour dicter" } }, "ja": { "stringUnit": { "state": "translated", "value": "%@を押して音声入力" } } } },
    "Hold your shortcut while speaking. Release it to transcribe on this Mac and copy the result to the clipboard.": { "extractionState": "manual", "localizations": { "de": { "stringUnit": { "state": "translated", "value": "Halte dein Tastenkürzel beim Sprechen gedrückt. Lass es los, um auf diesem Mac zu transkribieren und das Ergebnis in die Zwischenablage zu kopieren." } }, "es": { "stringUnit": { "state": "translated", "value": "Mantén pulsado tu atajo mientras hablas. Suéltalo para transcribir en este Mac y copiar el resultado al portapapeles." } }, "fr": { "stringUnit": { "state": "translated", "value": "Maintenez votre raccourci pendant que vous parlez. Relâchez-le pour transcrire sur ce Mac et copier le résultat dans le presse-papiers." } }, "ja": { "stringUnit": { "state": "translated", "value": "話している間ショートカットを押し続けます。離すとこのMacで文字起こしし、結果をクリップボードにコピーします。" } } } },
    "Microphone": { "extractionState": "manual", "localizations": { "de": { "stringUnit": { "state": "translated", "value": "Mikrofon" } }, "es": { "stringUnit": { "state": "translated", "value": "Micrófono" } }, "fr": { "stringUnit": { "state": "translated", "value": "Microphone" } }, "ja": { "stringUnit": { "state": "translated", "value": "マイク" } } } },
    "Input Monitoring": { "extractionState": "manual", "localizations": { "de": { "stringUnit": { "state": "translated", "value": "Eingabeüberwachung" } }, "es": { "stringUnit": { "state": "translated", "value": "Monitorización de entrada" } }, "fr": { "stringUnit": { "state": "translated", "value": "Surveillance de l’entrée" } }, "ja": { "stringUnit": { "state": "translated", "value": "入力監視" } } } },
    "On this Mac": { "extractionState": "manual", "localizations": { "de": { "stringUnit": { "state": "translated", "value": "Auf diesem Mac" } }, "es": { "stringUnit": { "state": "translated", "value": "En este Mac" } }, "fr": { "stringUnit": { "state": "translated", "value": "Sur ce Mac" } }, "ja": { "stringUnit": { "state": "translated", "value": "このMac上" } } } },
    "Opened only while dictating": { "extractionState": "manual", "localizations": { "de": { "stringUnit": { "state": "translated", "value": "Nur während des Diktats geöffnet" } }, "es": { "stringUnit": { "state": "translated", "value": "Se abre solo durante el dictado" } }, "fr": { "stringUnit": { "state": "translated", "value": "Ouvert uniquement pendant la dictée" } }, "ja": { "stringUnit": { "state": "translated", "value": "音声入力中のみ使用" } } } },
    "Open Accessibility Settings": { "extractionState": "manual", "localizations": { "de": { "stringUnit": { "state": "translated", "value": "Bedienungshilfen öffnen" } }, "es": { "stringUnit": { "state": "translated", "value": "Abrir ajustes de Accesibilidad" } }, "fr": { "stringUnit": { "state": "translated", "value": "Ouvrir les réglages d’accessibilité" } }, "ja": { "stringUnit": { "state": "translated", "value": "アクセシビリティ設定を開く" } } } },
    "Permissions": { "extractionState": "manual", "localizations": { "de": { "stringUnit": { "state": "translated", "value": "Berechtigungen" } }, "es": { "stringUnit": { "state": "translated", "value": "Permisos" } }, "fr": { "stringUnit": { "state": "translated", "value": "Autorisations" } }, "ja": { "stringUnit": { "state": "translated", "value": "権限" } } } },
    "Press-to-talk dictation": { "extractionState": "manual", "localizations": { "de": { "stringUnit": { "state": "translated", "value": "Diktat per Tastendruck" } }, "es": { "stringUnit": { "state": "translated", "value": "Dictado pulsar para hablar" } }, "fr": { "stringUnit": { "state": "translated", "value": "Dictée push-to-talk" } }, "ja": { "stringUnit": { "state": "translated", "value": "プッシュトゥトーク音声入力" } } } },
    "Press the full chord, then release…": { "extractionState": "manual", "localizations": { "de": { "stringUnit": { "state": "translated", "value": "Vollständiges Tastenkürzel drücken und loslassen …" } }, "es": { "stringUnit": { "state": "translated", "value": "Pulsa el atajo completo y suéltalo…" } }, "fr": { "stringUnit": { "state": "translated", "value": "Appuyez sur le raccourci complet, puis relâchez…" } }, "ja": { "stringUnit": { "state": "translated", "value": "ショートカット全体を押してから離してください…" } } } },
    "Press to record a new dictation shortcut. Press Escape to cancel.": { "extractionState": "manual", "localizations": { "de": { "stringUnit": { "state": "translated", "value": "Drücken, um ein neues Diktat-Tastenkürzel aufzunehmen. Escape bricht ab." } }, "es": { "stringUnit": { "state": "translated", "value": "Pulsa para grabar un nuevo atajo de dictado. Pulsa Escape para cancelar." } }, "fr": { "stringUnit": { "state": "translated", "value": "Appuyez pour enregistrer un nouveau raccourci de dictée. Appuyez sur Échap pour annuler." } }, "ja": { "stringUnit": { "state": "translated", "value": "押して新しい音声入力ショートカットを記録します。Escapeキーでキャンセルします。" } } } },
    "Processing": { "extractionState": "manual", "localizations": { "de": { "stringUnit": { "state": "translated", "value": "Verarbeitung" } }, "es": { "stringUnit": { "state": "translated", "value": "Procesamiento" } }, "fr": { "stringUnit": { "state": "translated", "value": "Traitement" } }, "ja": { "stringUnit": { "state": "translated", "value": "処理" } } } },
    "Required to detect your dictation shortcut in other apps.": { "extractionState": "manual", "localizations": { "de": { "stringUnit": { "state": "translated", "value": "Erforderlich, um dein Diktat-Tastenkürzel in anderen Apps zu erkennen." } }, "es": { "stringUnit": { "state": "translated", "value": "Necesario para detectar el atajo de dictado en otras apps." } }, "fr": { "stringUnit": { "state": "translated", "value": "Requis pour détecter votre raccourci de dictée dans les autres apps." } }, "ja": { "stringUnit": { "state": "translated", "value": "ほかのアプリで音声入力ショートカットを検出するために必要です。" } } } },
    "A small toast confirms each step": { "extractionState": "manual", "localizations": { "de": { "stringUnit": { "state": "translated", "value": "Eine kleine Einblendung bestätigt jeden Schritt" } }, "es": { "stringUnit": { "state": "translated", "value": "Un aviso breve confirma cada paso" } }, "fr": { "stringUnit": { "state": "translated", "value": "Une petite alerte confirme chaque étape" } }, "ja": { "stringUnit": { "state": "translated", "value": "小さな通知で各ステップを確認できます" } } } },
    "Captions are already running.": {
