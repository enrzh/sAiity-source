    },
    "Imported from %@. The translation prompt was tuned on Qwen; another family may behave differently.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus %@ importiert. Der Übersetzungs-Prompt wurde auf Qwen abgestimmt; eine andere Familie kann sich anders verhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importado de %@. El prompt de traducción se ajustó con Qwen; otra familia puede comportarse distinto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importé depuis %@. Le prompt de traduction a été réglé sur Qwen ; une autre famille peut se comporter différemment."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@から取り込みました。翻訳プロンプトはQwenに合わせて調整されているため、ほかのモデルファミリーでは動作が異なることがあります。"
          }
        }
      }
    },
    "Include my microphone": {
      "extractionState": "manual",
      "localizations": {
