    "Uses the shared local translation model with dictation's own target.": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Verwendet das gemeinsame lokale Übersetzungsmodell mit dem eigenen Diktat-Ziel." } },
        "es": { "stringUnit": { "state": "translated", "value": "Usa el modelo local de traducción compartido con el destino propio del dictado." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Utilise le modèle local de traduction partagé avec la propre langue cible de la dictée." } },
