    "Translating a saved transcript — wait for that to finish, or cancel it": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein gesichertes Transkript wird übersetzt – warte, bis das fertig ist, oder brich es ab"
          }
        },
        "es": {
