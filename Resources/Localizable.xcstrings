    "Captions roughly twice as often, for about double the recognition work per second of audio — noticeable on battery.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwa doppelt so häufig Untertitel, bei ungefähr doppelter Erkennungsarbeit pro Sekunde Ton – im Akkubetrieb spürbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Subtítulos con aproximadamente el doble de frecuencia, a cambio de cerca del doble de trabajo de reconocimiento por segundo de audio — se nota con batería."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des sous-titres environ deux fois plus fréquents, pour à peu près le double de travail de reconnaissance par seconde d'audio — sensible sur batterie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "字幕の更新頻度は約2倍になり、音声1秒あたりの認識処理も約2倍になります — バッテリー駆動では差が体感できます。"
          }
        }
      }
    },
