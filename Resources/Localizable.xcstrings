    },
    "Solid is the readable choice over bright video — glass leaves white text on a white scene at roughly 2:1 contrast.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deckend ist über hellem Video die lesbare Wahl – Glas lässt weißen Text auf heller Szene bei rund 2:1 Kontrast stehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sólido es la opción legible sobre vídeo claro — el cristal deja texto blanco sobre una escena blanca con un contraste de más o menos 2:1."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Opaque est le choix lisible sur une vidéo claire — le verre laisse du texte blanc sur une scène blanche à un contraste d'environ 2:1."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明るいビデオの上で読みやすいのは「単色」です — 「ガラス」では白いシーンに白い文字が重なり、コントラストは約2:1になります。"
          }
        }
      }
    },
    "Space": {
      "extractionState": "manual",
      "localizations": {
