    "The default is %@ ms. Shorter values split on breaths; longer values delay translation.": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Der Standardwert ist %@ ms. Kürzere Werte teilen bei Atempausen; längere verzögern die Übersetzung." } },
        "es": { "stringUnit": { "state": "translated", "value": "El valor predeterminado es %@ ms. Los valores menores dividen en las pausas; los mayores retrasan la traducción." } },
        "fr": { "stringUnit": { "state": "translated", "value": "La valeur par défaut est de %@ ms. Les valeurs plus courtes coupent aux respirations ; les plus longues retardent la traduction." } },
        "ja": { "stringUnit": { "state": "translated", "value": "デフォルトは%@ msです。短い値は息継ぎで分割し、長い値は翻訳を遅らせます。" } }
