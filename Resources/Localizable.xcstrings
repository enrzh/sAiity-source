          }
        }
      }
    },
    "Fast, but too small for usable translation — it drops and invents meaning. Listed for completeness.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schnell, aber zu klein für brauchbare Übersetzung – es lässt Bedeutung weg und erfindet welche. Der Vollständigkeit halber gelistet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rápido, pero demasiado pequeño para una traducción utilizable — pierde e inventa significado. Está en la lista por exhaustividad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapide, mais trop petit pour une traduction utilisable — il perd et invente du sens. Listé par souci d'exhaustivité."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高速ですが、実用的な翻訳には小さすぎます — 意味を落としたり作り出したりします。網羅性のために掲載しています。"
          }
        }
      }
    },
    "Forget this model and delete its file.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Modell vergessen und seine Datei löschen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvida este modelo y elimina su archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oublier ce modèle et supprimer son fichier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このモデルの登録を解除し、ファイルを削除します。"
          }
        }
      }
    },
