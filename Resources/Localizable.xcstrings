    "Hides the subtitles without stopping recognition, so you can keep a transcript running with nothing on screen.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blendet die Untertitel aus, ohne die Erkennung zu stoppen – so läuft ein Transkript weiter, ohne dass etwas auf dem Bildschirm steht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta los subtítulos sin detener el reconocimiento, para que puedas seguir grabando una transcripción sin nada en pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masque les sous-titres sans arrêter la reconnaissance, pour continuer une transcription sans rien à l'écran."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認識を止めずに字幕だけを隠します。画面には何も表示せずに、文字起こしを続けられます。"
          }
        }
      }
    },
    "Idle": {
