    },
    "No translator chosen yet. %@ is the one to start with: the broad-coverage default and a measured fast path. Download it under Models.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch kein Übersetzer gewählt. %@ ist der Einstieg: die Standardauswahl mit breiter Abdeckung und ein gemessener schneller Pfad. Lade ihn unter Modelle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no has elegido un traductor. %@ es el indicado para empezar: la opción predeterminada de amplia cobertura y una ruta rápida medida. Descárgalo en Modelos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun traducteur choisi pour l'instant. %@ est le bon point de départ : le choix par défaut à large couverture et une option rapide mesurée. Téléchargez-le sous Modèles."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "翻訳エンジンがまだ選択されていません。%@は幅広い言語をカバーするデフォルトで、実測でも高速な選択肢です。「モデル」からダウンロードしてください。"
          }
        }
      }
    },
    "MADLAD is the recommended local translator. Pick the target language under Captions.": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "MADLAD ist der empfohlene lokale Übersetzer. Wähle die Zielsprache unter Untertitel." } },
        "es": { "stringUnit": { "state": "translated", "value": "MADLAD es el traductor local recomendado. Elige el idioma de destino en Subtítulos." } },
        "fr": { "stringUnit": { "state": "translated", "value": "MADLAD est le traducteur local recommandé. Choisissez la langue cible dans Sous-titres." } },
        "ja": { "stringUnit": { "state": "translated", "value": "MADLADは推奨のローカル翻訳エンジンです。字幕で翻訳先の言語を選択してください。" } }
      }
    },
