    "Best quality of the Qwen sizes, but roughly twice the time per sentence — likely too slow to keep up.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beste Qualität der Qwen-Größen, aber rund die doppelte Zeit pro Satz – vermutlich zu langsam, um mitzuhalten."
          }
        }
      }
    },
