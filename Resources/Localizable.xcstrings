        "fr": { "stringUnit": { "state": "translated", "value": "Qualité expérimentale — vérifiez les traductions importantes." } },
        "ja": { "stringUnit": { "state": "translated", "value": "実験的な品質です。重要な翻訳は確認してください。" } }
      }
    },
