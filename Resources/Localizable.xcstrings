      }
    },
    "Allow Screen Recording": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildschirmaufnahme erlauben"
          }
        }
      }
    },
    "Allow…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlauben …"
          }
        }
      }
    },
    "Already allowed it in System Settings but still showing as not granted? macOS sometimes only applies it to a fresh launch.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schon in den Systemeinstellungen erlaubt, wird aber weiterhin als nicht erteilt angezeigt? macOS übernimmt das manchmal erst bei einem Neustart der App."
          }
        }
      }
    },
    "Also show a translation under each caption": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zusätzlich eine Übersetzung unter jedem Untertitel anzeigen"
          }
        }
      }
    },
    "Any language": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Sprache"
          }
        }
      }
    },
    "Apache-2.0 (Google MADLAD-400)": {
      "extractionState": "manual",
      "shouldTranslate": false
    },
    "Approve sAiity in System Settings → General → Login Items.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätige sAiity in den Systemeinstellungen → Allgemein → Anmeldeobjekte."
          }
        }
      }
    },
    "Asks aiity.de about once a day whether a newer version exists. The check sends no audio, no transcripts and no identifiers — but it is a network request, so it is off unless you want it. You can always check by hand from the menu bar.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragt etwa einmal täglich bei aiity.de nach, ob es eine neuere Version gibt. Die Abfrage sendet keinen Ton, keine Transkripte und keine Kennungen – aber sie ist eine Netzwerkanfrage und daher aus, solange du sie nicht möchtest. Über die Menüleiste kannst du jederzeit selbst nachsehen."
          }
        }
      }
    },
    "Audio never leaves this Mac. Recognition, translation and transcripts are all processed and stored locally — no account, no API key.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es verlässt kein Ton diesen Mac. Erkennung, Übersetzung und Transkripte werden alle lokal verarbeitet und gespeichert – kein Konto, kein API-Schlüssel."
          }
        }
      }
    },
    "Audio stream stopped — press Stop, then Start": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Audiostream gestoppt – drücke Stoppen, dann Starten"
