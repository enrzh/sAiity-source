<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Backs the opt-in "Include my microphone" setting. Under the hardened
       runtime (every identity-signed build) microphone access is gated on
       this entitlement — without it AVAudioEngine's input simply fails in
       exactly the builds users run, while unsigned dev builds work, which is
       the worst way to find out. -->
  <key>com.apple.security.device.audio-input</key><true/>
</dict>
</plist>
